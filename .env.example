# Supabase Postgres connection string:
# Supabase dashboard -> Connect -> ORMs / Connection string (pooler URI works for the app).
DATABASE_URL=

# Secret used to sign the login session cookie (at least 32 random characters).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Used only by `npm run db:seed` to create the first admin login
ADMIN_USER_ID=
ADMIN_PASSWORD=
